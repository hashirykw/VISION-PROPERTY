VP.boot(function(){
  const {$, $$, esc, D, img, I, clamp} = VP, P = D.P, find = s => P.find(p => p.s === s);
  /* hero: construct + method card synced */
  const li = $$('#methodList li');
  VP.stage($('#heroStage'), { dur: 3600, delay: 500, fit: .9, max: 360, onProgress: p => {
    const a = clamp(p / .42, 0, 1), b = clamp((p - .3) / .7, 0, 1), c = clamp((p - .92) / .08, 0, 1);
    [a, b, c].forEach((v, i) => { li[i].style.setProperty('--p', v); li[i].querySelector('.pb i').style.setProperty('--p', v); });
    li.forEach((l, i) => l.classList.toggle('on', i === (p >= 1 ? 2 : p > .42 ? 1 : 0)));
  }});
  $('#pcount').textContent = P.length;

  /* method stack */
  const ST = [
    { k: 'Blueprint', h: 'Meet a project at the blueprint.', img: find('saima-paari-excellency').pics[0], p: 'Early-stage projects are where buyers have the widest choice of floors and layouts. We track them from the announcement onwards.', l: ['saima-paari-excellency', 'saima-center-point', 'roomi-icon', 'roomi-city'], t: ['Pre-launch', 'Recently launched', 'Upcoming', 'Upcoming plots'] },
    { k: 'Build', h: 'Compare it honestly while it rises.', img: find('saima-marina-residence').pics[3], p: 'We shortlist from the developer projects we market and set locations, unit types and payment plans side by side. Then we visit the site with you and go through the paperwork.', l: ['saima-marina-residence', 'saima-waterfront', 'saars-3'], t: ['41 storeys', '40 storeys', 'Ground + 44'] },
    { k: 'Belong', h: 'Keys, and everything after.', img: find('saima-marina-residence').pics[9], p: 'We help with booking and the installment schedule. When you\'re ready to sell or rent, we use modern digital marketing to find qualified buyers and tenants.', l: ['paari-palace', 'saima-greens'], t: ['Installment plans', 'Flexible payment plans'] }
  ];
  $('#stack').innerHTML = ST.map((s, i) => `<article class="sc glass" style="--i:${i}" data-spot>${img(s.img, s.h)}<div class="tx"><span class="stp">0${i + 1} · ${s.k}</span><h3 class="h3">${esc(s.h)}</h3><p>${esc(s.p)}</p><ul>${s.l.map((x, j) => `<li><a href="project.html?p=${x}">${esc(find(x).n)} <span>${esc(s.t[j])}</span></a></li>`).join('')}</ul></div></article>`).join('');

  /* rise: storey counter + callouts at real heights */
  const CO = [
    { at: .06, s: 'l', y: 82, b: '5 floors of parking', t: 'Below the residences' },
    { at: .16, s: 'r', y: 72, b: 'Elegant reception lobby', t: 'Plus an in-house prayer area' },
    { at: .34, s: 'l', y: 58, b: 'Pool, sauna & Jacuzzi', t: 'With a modern gym and indoor games' },
    { at: .58, s: 'l', y: 42, b: '1, 2, 3 & 4 bed', t: 'Sea-view apartments' },
    { at: .82, s: 'r', y: 30, b: 'Earthquake-resistant', t: 'Fire-fighting on every floor, CCTV & guards' }
  ];
  $('#callouts').innerHTML = CO.map(c => `<div class="callout ${c.s}" style="top:${c.y}%"><span class="gc glass"><b>${c.b}</b>${c.t}</span><span class="ln"></span><span class="dt"></span></div>`).join('');
  const cos = $$('#callouts .callout'), word = $('#riseWord'), storey = $('#storey'), meter = $('#meter');
  const rst = $('#riseStage');
  rst.classList.add('go');
  let lastS = -1;
  VP.scrollBuild($('#rise'), (p, b) => {
    const s = Math.round(b * 40);
    if (s !== lastS) { lastS = s; storey.textContent = s; word.textContent = String(s).padStart(2, '0'); }
    meter.style.setProperty('--b', b);
    let lastOn = -1; cos.forEach((c, i) => { const on = b >= CO[i].at; c.classList.toggle('on', on); if (on) lastOn = i; });
    const cap = $('#riseCap'); if (lastOn >= 0) { if (cap.dataset.k != lastOn) { cap.dataset.k = lastOn; cap.innerHTML = `<b>${CO[lastOn].b}</b>${CO[lastOn].t}`; } cap.classList.toggle('on', b < 1); } else cap.classList.remove('on');
    $('#riseEnd').classList.toggle('on', b >= 1);
  });
  setTimeout(() => rst._fit && rst._fit(), 50);
  (function () { const st = rst; if (!VP.FINE || VP.RM) return; const tw = $('.tower', st);
    st.parentNode.addEventListener('pointermove', e => { const tr = tw.getBoundingClientRect(); st.style.setProperty('--lx', (e.clientX - tr.left) + 'px'); st.style.setProperty('--ly', (e.clientY - tr.top) + 'px'); st.classList.add('lens-on'); });
    st.parentNode.addEventListener('pointerleave', () => st.classList.remove('lens-on')); })();
  /* word fit for numbers */
  { const span = $('#riseWord'); const fit = () => { span.style.fontSize = Math.min(520, innerHeight * .52, innerWidth * .62) + 'px'; }; fit(); addEventListener('resize', fit); }

  /* featured rail */
  $('#feat').innerHTML = ['saima-marina-residence', 'saima-waterfront', 'roomi-icon', 'saars-3', 'paari-palace', 'saima-greens', 'roomi-towers', 'saima-jinnah-mall-residence', 'e-square', 'roomi-city'].map((s, i) => VP.card(find(s), i)).join('');

  /* corridors */
  const C = [
    { id: 'sea', n: 'DHA Phase VIII seafront', s: ['saima-waterfront', 'saima-marina-residence'] },
    { id: 'ja', n: 'Jinnah Avenue & University Road', s: ['roomi-icon', 'roomi-towers', 'saima-jinnah-mall-residence', 'saima-meadow-avenue'] },
    { id: 'nn', n: 'North Nazimabad', s: ['saars-tower', 'saima-premium-empire', 'saima-paari-excellency', 'e-square'] },
    { id: 'm9', n: 'Super Highway & M-9', s: ['paari-palace', 'roomi-city'] },
    { id: 'city', n: 'Across the city', s: ['saars-3', 'saima-greens', 'saima-dreams', 'saima-center-point'] }
  ];
  $('#cor').innerHTML = C.map(c => `<a class="cr" href="projects.html#${c.id}" data-img="${esc(find(c.s[0]).pics[0].src)}" data-fb="${esc(find(c.s[0]).pics[0].fb)}">${img(find(c.s[0]).pics[0], c.n, 'thumb')}<span><span class="nm">${esc(c.n)}</span><span class="ps">${c.s.map(x => esc(find(x).n)).join(' · ')}</span></span><span class="ct">${c.id === 'city' ? 'More projects' : c.s.length + ' projects'}</span><span class="go">${I.ne}</span></a>`).join('');
  const peek = $('#peek');
  if (VP.FINE && !VP.RM) {
    let px = 0, py = 0, tx = 0, ty = 0, raf;
    const loop = () => { px += (tx - px) * .18; py += (ty - py) * .18; peek.style.left = px + 'px'; peek.style.top = py + 'px'; raf = requestAnimationFrame(loop); };
    $$('#cor .cr').forEach(r => {
      r.addEventListener('pointerenter', e => { peek.innerHTML = img({ src: r.dataset.img, fb: r.dataset.fb }, ''); VP.wireImgs(peek); tx = px = e.clientX + 170; ty = py = e.clientY; peek.classList.add('on'); if (!raf) loop(); });
      r.addEventListener('pointermove', e => { tx = e.clientX + 170; ty = e.clientY; });
      r.addEventListener('pointerleave', () => { peek.classList.remove('on'); });
    });
    $('#cor').addEventListener('pointerleave', () => { cancelAnimationFrame(raf); raf = null; });
  }

  /* ring gallery */
  const R = []; const lim = p => p.s === 'saima-marina-residence' ? 5 : 1;
  for (let k = 0; k < 5; k++) P.forEach(p => { const x = p.pics[k]; if (x && k < lim(p) && R.length < 22) R.push({ src: x.src, fb: x.fb, cap: p.n, area: p.area, href: 'project.html?p=' + p.s }); });
  const ring = $('#ring'), stg = $('#ringStage'), n = R.length, step = 360 / n;
  ring.innerHTML = R.map((r, i) => `<button class="ri" style="--a:${i * step}deg" data-k="${i}" aria-label="Open photo of ${esc(r.cap)}">${img(r, r.cap)}</button>`).join('');
  const items = $$('.ri', ring);
  const size = () => { const w = Math.min(230, Math.max(130, stg.clientWidth * .17)); const Rr = Math.round(w * 1.02 / (2 * Math.tan(Math.PI / n))); ring.style.setProperty('--w', w + 'px'); ring.style.setProperty('--R', Rr + 'px'); stg.style.setProperty('--R', Rr + 'px'); };
  size(); addEventListener('resize', size);
  let rot = 0, vel = 0, drag = false, x0 = 0, r0 = 0, moved = 0, front = -1, visible = false;
  const draw = () => {
    ring.style.setProperty('--rot', rot + 'deg');
    let best = 0, bd = 999;
    items.forEach((it, i) => { let d = ((i * step + rot) % 360 + 540) % 360 - 180; const ad = Math.abs(d); if (ad < bd) { bd = ad; best = i; } it.style.opacity = ad > 100 ? .25 : 1 - ad / 260; });
    if (best !== front) { front = best; $('#rName').textContent = R[best].cap; $('#rArea').textContent = R[best].area; }
  };
  const loop = () => { if (!drag) { if (Math.abs(vel) > .01) { rot += vel; vel *= .94; } else if (visible && !VP.RM) rot -= .06; } draw(); requestAnimationFrame(loop); };
  new IntersectionObserver(es => es.forEach(e => visible = e.isIntersecting), { threshold: .1 }).observe(stg);
  stg.addEventListener('pointerdown', e => { drag = true; moved = 0; x0 = e.clientX; r0 = rot; vel = 0; stg.classList.add('drag'); stg.setPointerCapture(e.pointerId); });
  stg.addEventListener('pointermove', e => { if (!drag) return; const dx = e.clientX - x0; if (Math.abs(dx) > 5) moved = 1; const nr = r0 + dx * .25; vel = nr - rot; rot = nr; });
  stg.addEventListener('pointercancel', () => { drag = false; stg.classList.remove('drag'); });
  stg.addEventListener('pointerup', e => { drag = false; stg.classList.remove('drag'); if (!moved) { const it = document.elementsFromPoint(e.clientX, e.clientY).find(el => el.classList && el.classList.contains('ri')); if (it) VP.lightbox(R, +it.dataset.k); } });
  const snap = d => { const target = -((front + d) * step); let diff = ((target - rot) % 360 + 540) % 360 - 180; vel = diff * .08; };
  $('#rPrev').onclick = () => snap(-1); $('#rNext').onclick = () => snap(1);
  $('#rAll').onclick = () => VP.lightbox(R, front < 0 ? 0 : front);
  ring.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.classList.contains('ri')) VP.lightbox(R, +e.target.dataset.k); });
  loop();

  /* developers */
  $('#devs').innerHTML = D.AFF.map(a => `<div class="lg">${VP.rawImg(a, a.n)}<span>${esc(a.n)}</span></div>`).join('');
  $$('#devs img').forEach(im => im.addEventListener('vpfail', () => im.parentNode.classList.add('nf')));

  /* enquiry */
  $$('.seg').forEach(g => g.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; $$('button', g).forEach(x => x.setAttribute('aria-pressed', x === b)); }));
  VP.leadForm($('#lead'), f => ['Looking to: ' + $('[data-name=want] [aria-pressed=true]', f).textContent, 'Area: ' + $('#fa').value]);
});
