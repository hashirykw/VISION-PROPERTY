        <span class="glare"></span>
      </div>
      <a class="tile glass t-photo rv d2" href="project.html?p=saima-waterfront" data-tilt="6" data-spot id="bentoPhoto">
        <div class="cap glass lift"><span><b>Saima Waterfront</b><small>Crescent Bay · DHA Phase VIII</small></span><span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></span></div>
        <span class="glare"></span>
      </a>
      <div class="tile glass t-num t-red rv" data-tilt data-spot>
        <span class="ring"></span>
        <span class="label lift-s" style="color:rgba(255,255,255,.75)">Affiliations</span>
        <div class="lift"><b><span class="count" data-to="8">0</span></b><p>Developer affiliations, including Bahria, Emaar, Saima, Roomi and Paari.</p></div>
        <span class="glare"></span>
      </div>
      <div class="tile glass t-serv t-wide rv d1" data-tilt="5" data-spot>
        <span class="label lift-s">What we do</span>
