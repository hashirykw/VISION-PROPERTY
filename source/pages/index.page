===CSS===
/* ---------- hero ---------- */
.hero { position: relative; min-height: max(100svh, 720px); }
.hero-stage { position: absolute; inset: 0; --word-top: 15%; --th: 84%; --ta: .5813; --tx: 52%; }
.hero-ui { position: relative; z-index: 6; min-height: max(100svh, 720px); display: grid; grid-template-columns: minmax(0, 470px) minmax(0, 1fr) minmax(0, 350px); align-items: end; gap: var(--space-xl); padding-top: calc(var(--nav-h) + 40px); padding-bottom: clamp(28px, 4vw, 52px); pointer-events: none; }
.hero-ui > * { pointer-events: auto; }
.hero-copy .h1 { font-size: clamp(38px, 4.1vw, 64px); }
.hero-copy .lead { margin-top: var(--space-lg); font-size: 16.5px; }
.method { grid-column: 3; padding: 22px; border-radius: var(--r-lg); }
.method ol { list-style: none; display: grid; gap: 4px; }
.method li { position: relative; padding: 12px 14px 14px; border-radius: 14px; transition: background-color var(--dur-3) var(--ease-out); }
.method li.on { background: var(--glass-2); }
.method li b { display: flex; justify-content: space-between; font: 700 16px/1.2 var(--font-display); font-stretch: 112%; }
.method li b small { font: 500 11px/1.4 var(--font-mono); color: var(--ink-3); }
.method li span { display: block; margin-top: 4px; font-size: 13.5px; color: var(--ink-2); line-height: 1.45; }
.method li .pb { display: block; margin-top: 10px; height: 2px; border-radius: 2px; background: var(--stroke); overflow: hidden; }
.method li .pb i { display: block; height: 100%; background: linear-gradient(90deg, var(--red-lo), var(--red-hi)); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
.feat { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); margin-top: 12px; padding: 14px; border-radius: 16px; border: 1px solid var(--stroke); transition: border-color var(--dur-2), background-color var(--dur-2); }
.feat:hover { border-color: var(--stroke-3); background: var(--glass); }
.feat small { display: block; font-size: 12px; color: var(--ink-3); }
.feat b { display: block; font: 600 15px/1.25 var(--font-body); }
.feat svg { width: 18px; height: 18px; flex: none; transition: transform var(--dur-3) var(--ease-out); }
.feat:hover svg { transform: translateX(4px); }
.cap-render { position: absolute; z-index: 5; left: 52%; bottom: 14px; transform: translateX(-50%); font: 500 11px/1 var(--font-mono); letter-spacing: .08em; color: var(--ink-3); white-space: nowrap; }
@media (max-width: 1180px) { .hero-ui { grid-template-columns: minmax(0, 420px) minmax(0, 1fr) minmax(0, 320px); } .hero-stage { --tx: 54%; --th: 76%; } }
@media (max-width: 1020px) {
  .hero { min-height: 0; }
  .hero-stage { position: relative; height: min(74svh, 620px); --th: 82%; --tx: 50%; --word-top: 21%; }
  .hero-ui { min-height: 0; grid-template-columns: minmax(0, 1fr); padding-top: 0; margin-top: -60px; }
  .method { grid-column: auto; }
  .cap-render { bottom: 70px; font-size: 10px; }
  .cap-render { white-space: normal; text-align: center; width: 90%; }
}
@media (max-width: 620px) { .hero-stage { height: 64svh; } .acts .btn { flex: 1 1 auto; justify-content: space-between; } .method li span { font-size: 13px; } }

/* ---------- method (sticky stack) ---------- */
.mth { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
.mth-l { position: sticky; top: 130px; }
.mth-l .lead { margin-top: var(--space-lg); }
.stack { display: grid; gap: 28px; }
.sc { position: sticky; top: calc(120px + var(--i) * 26px); display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); min-height: 440px; overflow: hidden; padding: 0; }
.sc .ph { height: 100%; min-height: 260px; border-radius: 0; }
.sc .ph::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 60%, oklch(0% 0 0 / .25)); }
.sc .tx { padding: clamp(26px, 3vw, 40px); display: flex; flex-direction: column; gap: var(--space-md); position: relative; z-index: 1; }
.sc .stp { display: flex; align-items: center; gap: 10px; font: 500 12px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--red-hi); }
.sc .stp::after { content: ""; flex: 1; height: 1px; background: var(--stroke-2); }
.sc p { color: var(--ink-2); }
.sc ul { list-style: none; display: grid; gap: 2px; margin-top: auto; padding-top: var(--space-md); border-top: 1px solid var(--stroke); }
.sc li a { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 9px 2px; font-size: 14.5px; font-weight: 500; transition: color var(--dur-2); }
.sc li a span { color: var(--ink-3); font-weight: 400; font-size: 13px; }
.sc li a:hover { color: var(--red-hi); }
@media (max-width: 1020px) { .mth { grid-template-columns: minmax(0, 1fr); } .mth-l { position: static; } }
@media (max-width: 760px) { .stack { --mcol: 86%; } .sc { position: relative; top: auto; grid-template-columns: minmax(0, 1fr); min-height: 0; } .sc .ph { height: 200px; } }

/* ---------- rise (scroll-built tower) ---------- */
.rise { position: relative; height: 320vh; }
.rise-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
.rise .stage { position: absolute; inset: 0; --word-top: 12%; --th: 80%; --ta: .638; --tx: 50%; --tb: 2%; }
.rise .stage .word span { font-variant-numeric: tabular-nums; --word-a: oklch(100% 0 0 / .5); --word-b: oklch(100% 0 0 / 0); }
:root[data-theme="light"] .rise .stage .word span { --word-a: oklch(18% .01 20 / .45); --word-b: oklch(18% .01 20 / 0); }
.rise .stage { --word-top: 33%; }
.rise-cap { display: none; }
.rise-ui { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
.rise-ui > * { pointer-events: auto; }
.rise-head { position: absolute; left: var(--gut); top: calc(var(--nav-h) + 44px); max-width: 420px; }
.rise-head .lead { margin-top: var(--space-md); font-size: 16px; }
@media (max-width: 1240px) { .rise-head { max-width: 330px; } }
.rise-meter { position: absolute; right: var(--gut); top: calc(var(--nav-h) + 44px); width: 210px; padding: 18px; }
.rise-meter small { display: block; font-size: 12.5px; color: var(--ink-3); }
.rise-meter b { display: block; margin-top: 6px; font: 800 44px/1 var(--font-display); font-stretch: 112%; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
.rise-meter b span { font-size: 18px; color: var(--ink-3); font-weight: 600; }
.rise-meter .track { margin-top: 14px; height: 3px; border-radius: 3px; background: var(--stroke); overflow: hidden; }
.rise-meter .track i { display: block; height: 100%; background: linear-gradient(90deg, var(--red-lo), var(--red-hi)); transform-origin: 0 50%; transform: scaleX(var(--b, 0)); }
.callout { position: absolute; z-index: 6; display: flex; align-items: center; gap: 0; opacity: 0; transform: translateY(14px); transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out); }
.callout.on { opacity: 1; transform: none; }
.callout .ln { width: clamp(30px, 6vw, 90px); height: 1px; background: linear-gradient(90deg, var(--red-hi), var(--stroke-3)); }
.callout .dt { width: 9px; height: 9px; border-radius: 50%; background: var(--red-hi); box-shadow: 0 0 0 4px var(--red-soft); flex: none; }
.callout .gc { padding: 12px 16px; border-radius: 14px; max-width: 250px; font-size: 13.5px; line-height: 1.4; }
.callout .gc b { display: block; font: 600 14.5px/1.3 var(--font-body); }
.callout.l { right: calc(50% + 120px); flex-direction: row; }
.callout.r { left: calc(50% + 110px); flex-direction: row-reverse; }
.callout.r .ln { background: linear-gradient(270deg, var(--red-hi), var(--stroke-3)); }
.rise-end { position: absolute; left: 50%; bottom: 34px; transform: translate(-50%, 16px); opacity: 0; transition: opacity var(--dur-3), transform var(--dur-3) var(--ease-out); }
.rise-end.on { opacity: 1; transform: translate(-50%, 0); }
@media (max-width: 860px) {
  .rise { height: 260vh; }
  .rise .stage { --th: 62%; --tb: 4%; --word-top: 22%; }
  .rise-head { right: var(--gut); max-width: none; }
  .rise-head .lead { display: none; }
  .rise-meter { top: calc(var(--nav-h) + 104px); bottom: auto; right: auto; left: var(--gut); width: auto; padding: 10px 14px; display: flex; align-items: baseline; gap: 10px; }
  .rise-meter b { font-size: 26px; margin: 0; } .rise-meter .track { display: none; }
  .callout { display: none; }
  .rise-cap { display: block; position: absolute; left: var(--gut); right: var(--gut); bottom: 84px; padding: 12px 16px; border-radius: 16px; font-size: 13.5px; opacity: 0; transition: opacity var(--dur-3); }
  .rise-cap.on { opacity: 1; } .rise-cap b { display: block; font-weight: 600; font-size: 14.5px; }
  .rise-end { bottom: 22px; left: var(--gut); right: auto; transform: translateY(16px); } .rise-end.on { transform: none; }
  .rise-cap { bottom: 90px; }
  .rise .stage { --word-top: 30%; }
}

/* ---------- corridors ---------- */
.cor { padding: 10px clamp(10px, 2vw, 22px); }
.cr { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: var(--space-xl); padding: clamp(18px, 2.4vw, 28px) 8px; border-bottom: 1px solid var(--stroke); transition: padding var(--dur-3) var(--ease-out); }
.cr:last-child { border-bottom: 0; }
.cr .nm { font: 700 clamp(24px, 3.3vw, 46px)/1.02 var(--font-display); font-stretch: 112%; letter-spacing: -.03em; transition: color var(--dur-2), transform var(--dur-3) var(--ease-out); }
.cr .ps { display: block; margin-top: 8px; font-size: 14px; color: var(--ink-3); }
.cr .ct { font: 500 13px/1 var(--font-mono); color: var(--ink-3); white-space: nowrap; }
.cr .go { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--stroke-2); transition: background-color var(--dur-2), border-color var(--dur-2), color var(--dur-2), transform var(--dur-3) var(--ease-out); }
.cr .go svg { width: 18px; height: 18px; }
.cr:hover .nm { color: var(--red-hi); transform: translateX(8px); }
.cr:hover .go { background: var(--red); border-color: var(--red); color: var(--on-red); transform: rotate(-45deg); }
.cr .thumb { display: none; }
.peek { position: fixed; z-index: 60; left: 0; top: 0; width: 280px; aspect-ratio: 4 / 3; border-radius: 20px; padding: 6px; pointer-events: none; opacity: 0; transform: translate(-50%, -50%) scale(.85) rotate(-4deg); transition: opacity var(--dur-2), transform var(--dur-3) var(--ease-out); }
.peek.on { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(-2deg); }
.peek .ph { width: 100%; height: 100%; border-radius: 15px; }
@media (max-width: 760px) {
  .cor { padding: 0; background: none; border: 0; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; --mcol: 74%; }
  .cr { display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 8px; border: 1px solid var(--stroke); border-radius: var(--r-lg); background: linear-gradient(155deg, var(--glass-2), var(--glass)); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .cr .thumb { display: block; height: 150px; border-radius: 18px; margin-bottom: 14px; }
  .cr .nm { font-size: 22px; padding: 0 8px; } .cr .ps { padding: 0 8px; font-size: 13px; }
  .cr .ct { padding: 12px 8px 8px; } .cr .go { display: none; }
}

/* ---------- ring gallery ---------- */
.ring-sec { overflow: hidden; }
.ring-stage { position: relative; height: clamp(380px, 46vw, 560px); perspective: 1700px; perspective-origin: 50% 40%; touch-action: pan-y; cursor: grab; user-select: none; }
.ring-stage.drag { cursor: grabbing; }
.ring { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; transform: translateZ(calc(var(--R) * -1)) rotateX(-6deg) rotateY(var(--rot, 0deg)); }
.ri { position: absolute; width: var(--w); height: calc(var(--w) * 1.28); left: calc(var(--w) / -2); top: calc(var(--w) * -.64); border-radius: 18px; padding: 5px; transform: rotateY(var(--a)) translateZ(var(--R)); transition: opacity var(--dur-2), filter var(--dur-2); background: linear-gradient(155deg, var(--glass-3), var(--glass)); border: 1px solid var(--stroke-2); box-shadow: var(--shadow-s); -webkit-backface-visibility: hidden; backface-visibility: hidden; }
.ri .ph { width: 100%; height: 100%; border-radius: 13px; }
.ri:hover { filter: brightness(1.08); }
.ring-floor { position: absolute; left: 10%; right: 10%; bottom: 4%; height: 26%; background: radial-gradient(50% 50% at 50% 50%, var(--red-soft), transparent 70%); filter: blur(20px); pointer-events: none; }
.ring-cap { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-md) var(--space-lg); margin-top: var(--space-lg); }
.ring-cap .now { min-width: 0; text-align: center; }
.ring-cap .now b { display: block; font: 700 18px/1.2 var(--font-display); font-stretch: 110%; }
.ring-cap .now small { color: var(--ink-3); font-size: 13px; }

/* ---------- enquiry ---------- */
.enq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); overflow: hidden; padding: 0; border-radius: var(--r-xl); }
.enq-l { position: relative; padding: clamp(28px, 4vw, 56px); display: flex; flex-direction: column; gap: var(--space-lg); overflow: hidden; }
.enq-l .lines { display: grid; gap: 4px; margin-top: auto; position: relative; z-index: 1; }
.enq-l .lines a { display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); padding: 14px 0; border-bottom: 1px solid var(--stroke); font-weight: 500; transition: color var(--dur-2); }
.enq-l .lines a span { color: var(--ink-3); font-weight: 400; font-size: 14px; }
.enq-l .lines a:hover { color: var(--red-hi); }
.enq-l .bgt { position: absolute; right: -6%; bottom: -8%; height: 70%; opacity: .14; pointer-events: none; }
.enq-r { padding: clamp(28px, 4vw, 56px); display: grid; gap: var(--space-lg); align-content: start; background: var(--glass); border-left: 1px solid var(--stroke); }
@media (max-width: 900px) { .enq { grid-template-columns: minmax(0, 1fr); } .enq-r { border-left: 0; border-top: 1px solid var(--stroke); } }
