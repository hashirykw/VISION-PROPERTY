@page: index
@title: Vision Properties — Real Estate Marketing & Investment Consulting, Karachi
@desc: Vision Properties markets apartments, plots and commercial projects across Karachi, from the DHA Phase VIII seafront to the M-9 Super Highway. Honest guidance, transparent dealings.
===CSS===
/* hero */
.hero{position:relative;min-height:100svh;display:flex;align-items:center;padding:calc(var(--nav-h) + 60px) 0 120px}
.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;width:min(var(--wrap),100%)}
.hero .display{margin:22px 0 0;max-width:12ch}
.hero .lead{margin-top:24px}
.hero .ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:46px;max-width:560px;border-radius:var(--r-3);overflow:hidden}
.stats > div{padding:18px 20px;position:relative}
.stats > div + div::before{content:"";position:absolute;left:0;top:18px;bottom:18px;width:1px;background:var(--line-2)}
.stats b{display:block;font:800 clamp(26px,2.6vw,36px)/1 var(--f-head);letter-spacing:-.03em}
.stats b sup{font-size:.5em;color:var(--red-2);vertical-align:top;margin-left:2px}
.stats > div > span{font-size:12.5px;color:var(--ink-3);line-height:1.35;display:block;margin-top:8px}
.hero-art{position:relative;height:min(620px,70vh);pointer-events:none}
.fan{position:absolute;right:4%;bottom:2%;width:min(340px,80%);height:310px;pointer-events:auto;perspective:1200px}
.fan .fc{position:absolute;inset:0;padding:9px;border-radius:24px;display:block;transform-origin:50% 110%;transition:transform 1s var(--e-out),filter .8s,box-shadow .6s}
.fan .fc .ph{height:212px;border-radius:16px}
.fan .fc:nth-child(1){transform:rotate(-10deg) translate(-46px,14px) scale(.88);filter:brightness(.7);z-index:1}
.fan .fc:nth-child(2){transform:rotate(7deg) translate(40px,6px) scale(.93);filter:brightness(.82);z-index:2}
.fan .fc:nth-child(3){transform:none;z-index:3}
.fan:hover .fc:nth-child(1){transform:rotate(-17deg) translate(-130px,-4px) scale(.88);filter:none}
.fan:hover .fc:nth-child(2){transform:rotate(13deg) translate(126px,-2px) scale(.93);filter:none}
.fan:hover .fc:nth-child(3){transform:translateY(-12px)}
.fan .badge{position:absolute;top:-13px;left:18px;z-index:4}
.fan .nb{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px 6px 4px}
.fan .nb b{font:700 15px/1.2 var(--f-head);display:block}
.fan .nb small{font-size:12px;color:var(--ink-3)}
.orbit-tag{position:absolute;padding:10px 14px;border-radius:14px;font-size:12.5px;display:flex;align-items:center;gap:8px;pointer-events:auto;animation:floaty 6s ease-in-out infinite}
.orbit-tag b{font-family:var(--f-head);font-weight:700}
.orbit-tag.t1{top:8%;left:4%}.orbit-tag.t2{top:42%;right:-2%;animation-delay:-2s}
@keyframes floaty{50%{transform:translateY(-10px)}}
.scroll-cue{position:absolute;left:50%;bottom:30px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;font:500 10px/1 var(--f-mono);letter-spacing:.24em;text-transform:uppercase;color:var(--ink-3)}
.scroll-cue .mouse{width:26px;height:42px;border-radius:14px;border:1.5px solid var(--line-3);display:flex;justify-content:center;padding-top:8px;backdrop-filter:blur(8px)}
.scroll-cue .mouse i{width:3px;height:8px;border-radius:3px;background:var(--red-2);animation:wheel 1.8s var(--e-out) infinite}
@keyframes wheel{0%{transform:translateY(0);opacity:1}80%{transform:translateY(12px);opacity:0}100%{opacity:0}}
@media (max-width:980px){.hero .wrap{grid-template-columns:1fr}.hero-art{height:360px;margin-top:10px}.orbit-tag.t2{right:0}}
@media (max-width:620px){.stats{grid-template-columns:1fr 1fr 1fr}.stats>div{padding:14px 12px}.stats b{font-size:22px;white-space:nowrap}.stats > div > span{font-size:11px}.orbit-tag{display:none}.hero-art{height:300px}.fan{right:0;left:0;margin:auto;width:min(300px,78%);height:290px}.fan .fc .ph{height:190px}.scroll-cue{display:none}}

/* bento */
.bento{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:minmax(220px,auto);gap:16px;perspective:1400px}
.tile{padding:clamp(22px,2.4vw,32px);overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;gap:18px}
.tile .lift{position:relative;z-index:4}
.t-big{grid-column:span 2;grid-row:span 2}
.t-big p{color:var(--ink-2);margin-top:16px;max-width:46ch}
.t-big .links{display:flex;flex-wrap:wrap;gap:10px}
.t-num b{font:800 clamp(46px,4.6vw,68px)/1 var(--f-head);letter-spacing:-.04em}
.t-num b sup{font-size:.45em;color:var(--red-2)}
.t-num p{color:var(--ink-3);font-size:14px;max-width:26ch}
.t-red{background:linear-gradient(150deg,var(--red-2),var(--red) 45%,var(--red-3));color:#fff;border-color:transparent}
.t-red p{color:rgba(255,255,255,.85)}
.t-red b sup{color:#fff}
.t-red .ring{position:absolute;right:-60px;top:-60px;width:200px;height:200px;border-radius:50%;border:1px solid rgba(255,255,255,.25);box-shadow:0 0 0 30px rgba(255,255,255,.05),0 0 0 60px rgba(255,255,255,.03)}
.t-photo{grid-row:span 2;padding:0;min-height:460px}
.t-photo .ph{position:absolute;inset:0;border-radius:inherit}
.t-photo:hover .ph img{transform:scale(1.06)}
.t-photo .cap{position:absolute;left:12px;right:12px;bottom:12px;z-index:4;padding:16px;border-radius:16px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.t-photo .cap b{font:700 16px/1.2 var(--f-head);display:block}
.t-photo .cap small{font-size:12px;color:var(--ink-3)}
.t-photo .cap .go{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--red);color:#fff;flex:none}
.t-photo .cap .go svg{width:16px;height:16px}
.t-serv ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:10px}
.t-serv li{display:flex;align-items:center;gap:10px;font-weight:600;font-size:14.5px}
.t-serv li i{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:var(--red-a);color:var(--red-2);flex:none}
.t-serv li i svg{width:16px;height:16px}
.t-wide{grid-column:span 2}
.arow{display:flex;flex-wrap:wrap;gap:8px}.arow .chip{height:36px;padding:0 14px;font-size:13px;transition:border-color .3s,color .3s}.arow .chip:hover{border-color:var(--red);color:var(--red-2)}
.skyl{width:100%;height:90px;color:var(--ink-4)}
@media (max-width:1000px){.bento{grid-template-columns:1fr 1fr}.t-big{grid-row:auto}.t-photo{grid-column:span 2;grid-row:auto;min-height:380px}}
@media (max-width:620px){.bento{grid-template-columns:1fr}.t-big,.t-wide,.t-photo{grid-column:auto}}

/* areas accordion */
.acc{display:flex;gap:12px;height:clamp(440px,48vw,580px)}
.pnl{position:relative;flex:1;border-radius:var(--r-4);overflow:hidden;cursor:pointer;transition:flex 1s var(--e-out);min-width:0;border:1px solid var(--line)}
.pnl.on{flex:4.4}
.pnl .ph{position:absolute;inset:0}
.pnl .ph img{transform:scale(1.15);filter:saturate(.8)}
.pnl.on .ph img{transform:scale(1);filter:none}
.pnl::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(0,0,0,.1) 25%,rgba(8,8,10,.9))}
.pnl .vl{position:absolute;z-index:2;left:50%;bottom:26px;transform:translateX(-50%) rotate(180deg);writing-mode:vertical-rl;font:700 15px/1 var(--f-head);letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;color:#fff;transition:opacity .4s}
.pnl .vl em{font:400 12px/1 var(--f-mono);font-style:normal;color:var(--red-2);margin-bottom:14px}
.pnl.on .vl{opacity:0}
.pnl .pb{position:absolute;z-index:3;left:14px;right:14px;bottom:14px;padding:clamp(20px,2.6vw,30px);border-radius:22px;color:#fff;opacity:0;transform:translateY(24px);transition:opacity .5s .25s,transform .8s .2s var(--e-out);
  background:rgba(14,14,17,.42);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4)}
.pnl.on .pb{opacity:1;transform:none}
.pnl .pb .mono{color:var(--red-2)}
.pnl .pb h3{font:800 clamp(22px,2.6vw,34px)/1.05 var(--f-head);letter-spacing:-.02em;margin:8px 0 10px}
.pnl .pb p{color:rgba(255,255,255,.82);max-width:54ch;font-size:15px}
.pnl .pb .row{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.pnl .pb .chip{color:#fff;background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.18)}
.pnl .pb .chip:hover{background:var(--red);border-color:var(--red)}
@media (max-width:760px){.acc{flex-direction:column;height:auto}.pnl{flex:none;height:84px;transition:height .8s var(--e-out)}.pnl.on{height:460px}
  .pnl .vl{writing-mode:horizontal-tb;transform:none;left:22px;bottom:auto;top:50%;translate:0 -50%;font-size:14px}.pnl .vl em{margin:0 10px 0 0}}

/* spotlight */
.spot{position:relative;border-radius:var(--r-5);overflow:hidden;min-height:clamp(560px,52vw,700px);border:1px solid var(--line-2);box-shadow:var(--shadow);isolation:isolate}
.spot .bgs .ph{position:absolute;inset:0;opacity:0;transform:scale(1.1);transition:opacity 1.2s var(--e-out),transform 7s linear}
.spot .bgs .ph.on{opacity:1;transform:scale(1)}
.spot::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(8,8,10,.86),rgba(8,8,10,.3) 60%,rgba(8,8,10,.15)),linear-gradient(0deg,rgba(8,8,10,.75),transparent 55%)}
.spot-in{position:relative;z-index:2;display:grid;grid-template-columns:1fr auto;gap:24px;padding:clamp(26px,5vw,64px);min-height:inherit;align-content:space-between;color:#fff}
.spot .title{max-width:13ch}
.spot .label{color:rgba(255,255,255,.6)}
.tabs{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;align-self:start}
.tabs button{height:44px;padding:0 18px;border-radius:999px;font-size:13px;font-weight:600;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.25);backdrop-filter:blur(10px);transition:all .4s var(--e-out);position:relative;overflow:hidden}
.tabs button.on{background:var(--red);border-color:var(--red);box-shadow:0 10px 26px -10px var(--red-glow)}
.tabs button .bar{position:absolute;left:0;bottom:0;height:2px;width:0;background:#fff}
.tabs button.on .bar{animation:fillw 7s linear forwards}
@keyframes fillw{to{width:100%}}
.gcard{grid-column:2;justify-self:end;align-self:end;width:min(440px,100%);padding:26px;border-radius:26px;background:rgba(20,20,24,.35);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(24px) saturate(1.5);-webkit-backdrop-filter:blur(24px) saturate(1.5);box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 30px 60px -30px rgba(0,0,0,.7)}
.gcard .mono{color:var(--red-2)}
.gcard h3{font:800 26px/1.08 var(--f-head);letter-spacing:-.02em;margin:8px 0}
.gcard p{font-size:14.5px;color:rgba(255,255,255,.82)}
.gcard ul{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:16px 0 20px}
.gcard li{font-size:12px;padding:6px 11px;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.12)}
.gcard .sw8{transition:opacity .35s,transform .5s var(--e-out)}
.gcard .sw8.out{opacity:0;transform:translateY(10px)}
@media (max-width:860px){.spot-in{grid-template-columns:1fr}.tabs{justify-content:flex-start}.gcard{grid-column:1;justify-self:stretch}}

/* coverflow */
.flow{position:relative;height:clamp(380px,42vw,520px);perspective:1600px;margin-top:10px;touch-action:pan-y}
.flow .it{position:absolute;left:50%;top:0;width:min(560px,74vw);height:100%;margin-left:calc(min(560px,74vw) / -2);border-radius:var(--r-4);overflow:hidden;transition:transform .9s var(--e-out),opacity .9s var(--e-out),filter .9s;cursor:pointer;border:1px solid var(--line-2);box-shadow:var(--shadow)}
.flow .it .ph{position:absolute;inset:0}
.flow .it .cap{position:absolute;left:14px;right:14px;bottom:14px;padding:14px 16px;border-radius:16px;color:#fff;background:rgba(14,14,17,.4);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);display:flex;justify-content:space-between;align-items:center;gap:10px;z-index:3}
.flow .it .cap b{font:700 16px/1.2 var(--f-head)}
.flow .it .cap span{font:500 10.5px/1 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6)}
.flow-ctl{display:flex;justify-content:center;align-items:center;gap:14px;margin-top:24px}
.flow-ctl .dots{display:flex;gap:6px}
.flow-ctl .dots i{width:8px;height:8px;border-radius:8px;background:var(--line-3);transition:width .5s var(--e-out),background .4s}
.flow-ctl .dots i.on{width:28px;background:var(--red)}
.note{text-align:center;font:500 11px/1 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-4);margin-top:16px}

/* photo wall */
.wall{display:grid;gap:14px;overflow:hidden;padding:6px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.wrow{display:flex;gap:14px;width:max-content;animation:mq 80s linear infinite}
.wrow.rev{animation-direction:reverse;animation-duration:95s}
.wall:hover .wrow{animation-play-state:paused}
.wi{position:relative;flex:none;width:clamp(230px,24vw,340px);aspect-ratio:4/3;border-radius:20px;overflow:hidden;border:1px solid var(--line-2);cursor:zoom-in;box-shadow:var(--shadow-s);background:var(--panel-solid)}
.wrow.rev .wi{aspect-ratio:3/2.3}
.wi .ph{position:absolute;inset:0}
.wi:hover .ph img{transform:scale(1.08)}
.wi::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(8,8,10,.75));pointer-events:none}
.wi .chip{position:absolute;left:10px;bottom:10px;z-index:2;color:#fff;background:rgba(10,10,12,.5);border-color:rgba(255,255,255,.18)}
/* steps */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;position:relative;perspective:1400px}
.steps .line{position:absolute;left:5%;right:5%;top:52px;height:1px;background:repeating-linear-gradient(90deg,var(--line-3) 0 6px,transparent 6px 12px)}
.steps .line i{position:absolute;inset:0;background:linear-gradient(90deg,var(--red-3),var(--red-2));transform-origin:0 50%;transform:scaleX(0);transition:transform 2s var(--e-out)}
.steps.in .line i{transform:scaleX(1)}
.st{padding:26px;display:flex;flex-direction:column;gap:12px;min-height:280px}
.st .n{width:56px;height:56px;border-radius:18px;display:grid;place-items:center;background:var(--panel-solid);border:1px solid var(--line-2);position:relative;z-index:4;transition:background .4s,color .4s,border-color .4s}
.st .n svg{width:24px;height:24px;color:var(--red-2);transition:color .4s}
.st:hover .n{background:var(--red);border-color:var(--red)}.st:hover .n svg{color:#fff}
.st .big{position:absolute;right:20px;top:14px;font:400 74px/1 var(--f-serif);font-style:italic;color:var(--ink-4);opacity:.6}
.st h3{font:700 18px/1.2 var(--f-head);margin-top:10px}
.st p{font-size:14.5px;color:var(--ink-2)}
@media (max-width:1000px){.steps{grid-template-columns:1fr 1fr}.steps .line{display:none}}
@media (max-width:560px){.steps{grid-template-columns:1fr}.st{min-height:0}}
