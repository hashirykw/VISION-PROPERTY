@page: projects
@title: Projects — Vision Properties, Karachi
@desc: Browse every project Vision Properties markets: sea-facing towers in DHA Phase VIII, gated communities on the M-9, plots, malls and commercial projects across Karachi.
===CSS===
.tools{position:sticky;top:96px;z-index:20;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding:10px;border-radius:24px;margin-bottom:28px}
.search{position:relative;flex:1 1 260px;max-width:420px}
.search svg{position:absolute;left:18px;top:50%;width:18px;height:18px;transform:translateY(-50%);color:var(--ink-3)}
.search .inp{height:48px;border-radius:999px;padding-left:48px}
.tools .seg button{height:40px}
.cnt{font:500 11px/1 var(--f-mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);padding:0 10px}
.empty{display:none;text-align:center;padding:60px 20px;border-radius:var(--r-4)}
.empty.show{display:block}
.empty h3{font:700 22px/1.2 var(--f-head);margin-bottom:8px}
.legend{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}
@media (max-width:760px){.tools{top:84px;border-radius:20px}.tools .seg{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;width:100%;padding-bottom:2px}.tools .seg::-webkit-scrollbar{display:none}.tools .seg button{flex:none}.search{max-width:none}}
