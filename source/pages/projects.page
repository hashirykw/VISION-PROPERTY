===JS===
VP.boot(function(){
  const {$, $$, D} = VP, P = D.P;
  $('#total').textContent = P.length;
  const grid = $('#grid'); grid.innerHTML = P.map((p,i) => VP.card(p, i)).join('');
  const cards = $$('.pcard', grid); let f = 'all', q = '';
  const apply = () => { let n = 0;
    cards.forEach(c => { const ok = (f === 'all' || c.dataset.f.split(' ').includes(f)) && (!q || c.dataset.name.includes(q)); c.classList.toggle('hide', !ok); if (ok) { n++; c.classList.add('in'); } });
    $('#cnt').textContent = n + (n === 1 ? ' project' : ' projects'); $('#empty').classList.toggle('show', !n); };
  const setF = k => { f = k; $$('#seg button').forEach(b => b.classList.toggle('on', b.dataset.f === k)); apply(); };
  $('#seg').addEventListener('click', e => { const b = e.target.closest('button'); if (b) { setF(b.dataset.f); history.replaceState(null, '', b.dataset.f === 'all' ? location.pathname : '#' + b.dataset.f); } });
  let t; $('#q').addEventListener('input', e => { clearTimeout(t); t = setTimeout(() => { q = e.target.value.trim().toLowerCase(); apply(); }, 120); });
  const h = location.hash.slice(1); if (h && $(`#seg [data-f="${h}"]`)) setF(h); else apply();
});
