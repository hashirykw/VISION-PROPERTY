===JS===
VP.boot(function(){
  const {$, $$, esc, D} = VP, P = D.P, find = s => P.find(p => p.s === s);
  VP.stage($('#pStage'), { dur: 3000, delay: 300, fit: .98, max: 320 });
  const G = [
    { id: 'sea', n: 'DHA Phase VIII seafront', d: 'High-rise living by the Arabian Sea, in two towers of 40 and 41 storeys.', s: ['saima-waterfront', 'saima-marina-residence'] },
    { id: 'ja', n: 'Jinnah Avenue & University Road', d: 'Twin towers, executive apartments and a mall near the airport and Malir Cantt.', s: ['roomi-icon', 'roomi-towers', 'saima-jinnah-mall-residence', 'saima-meadow-avenue'] },
    { id: 'nn', n: 'North Nazimabad', d: 'Our home neighbourhood, from the main 320 ft road to Main Food Street.', s: ['saars-tower', 'saima-premium-empire', 'saima-paari-excellency', 'e-square'] },
    { id: 'm9', n: 'Super Highway & M-9', d: 'Gated communities and plots with room to grow.', s: ['paari-palace', 'roomi-city'] },
    { id: 'com', n: 'Malls & commercial', d: 'Mixed-use towers, malls, offices and business parks.', s: ['saima-mall-residency', 'saima-business-park', 'saima-center-point', 'paari-palace-corner'] },
    { id: 'city', n: 'Across the city', d: 'Civil Lines, Shahra-e-Faisal, Gulzar-e-Hijri, Callachi Society and more.', s: ['saars-3', 'saima-greens', 'saima-dreams', 'al-reef-twin-tower', 'al-reef-residency', 'paari-avenue', 'saima-shield', 'saima-luxury-apartments', 'aa-beverly'] }
  ];
  $('#jump').innerHTML = G.map(g => `<a href="#${g.id}" data-g="${g.id}">${esc(g.n.replace(' & University Road', '').replace(' seafront', ''))} <span>${g.s.length}</span></a>`).join('');
  $('#groups').innerHTML = G.map(g => `<section class="grp" id="${g.id}" aria-labelledby="h-${g.id}"><div class="grp-h"><div><h2 class="h3" id="h-${g.id}">${esc(g.n)}</h2><p>${esc(g.d)}</p></div><span class="n">${g.s.length} ${g.s.length === 1 ? 'project' : 'projects'}</span></div><div class="mrail">${g.s.map((s, i) => VP.card(find(s), i)).join('')}</div></section>`).join('');
  const tw = ['Zero','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen','Twenty','Twenty-one','Twenty-two','Twenty-three','Twenty-four','Twenty-five','Twenty-six','Twenty-seven','Twenty-eight','Twenty-nine','Thirty'][P.length] || P.length;
  $('#tw').textContent = tw;
  const cards = $$('#groups .pc'), groups = $$('.grp');
  const apply = q => { let n = 0;
    cards.forEach(c => { const ok = !q || c.dataset.name.includes(q); c.classList.toggle('hide', !ok); if (ok) { n++; c.classList.add('in'); } });
    groups.forEach(g => g.hidden = !$$('.pc:not(.hide)', g).length);
    $('#cnt').textContent = n + (n === 1 ? ' project' : ' projects'); $('#empty').classList.toggle('show', !n); };
  let t; $('#q').addEventListener('input', e => { clearTimeout(t); t = setTimeout(() => apply(e.target.value.trim().toLowerCase()), 120); });
  apply('');
  /* jump highlight */
  const jl = $$('#jump a');
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { jl.forEach(a => a.classList.toggle('on', a.dataset.g === e.target.id)); const a = jl.find(x => x.dataset.g === e.target.id), j = $('#jump'); if (a) j.scrollTo({ left: a.offsetLeft - j.clientWidth / 2 + a.offsetWidth / 2, behavior: 'smooth' }); } }), { rootMargin: '-40% 0px -55% 0px' });
  groups.forEach(g => io.observe(g));
});
