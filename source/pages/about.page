===CSS===
.phero .stage { --word-top: 14%; --th: 92%; --ta: .3654; --tx: 74%; }
@media (max-width: 860px) { .phero .stage { --tx: 66%; --th: 86%; --word-top: 26%; } }
.vmm { --cols: 3; --mcol: 84%; }
.vm { padding: clamp(24px, 3vw, 36px); border-radius: var(--r-lg); display: flex; flex-direction: column; gap: var(--space-lg); min-height: 340px; }
.vm .q { font: 500 clamp(19px, 1.6vw, 23px)/1.45 var(--font-body); letter-spacing: -.01em; color: var(--ink); }
.vm .who { margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding-top: var(--space-md); border-top: 1px solid var(--stroke); }
.vm .who b { font: 700 18px/1.2 var(--font-display); font-stretch: 112%; }
.vm .who span { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--red-soft); color: var(--red-hi); }
.vm .who svg { width: 17px; height: 17px; }
.vals { --cols: 4; --mcol: 72%; }
.val { padding: 26px; border-radius: var(--r-lg); min-height: 280px; display: flex; flex-direction: column; gap: 12px; }
.val .ic { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; background: var(--glass-2); border: 1px solid var(--stroke); color: var(--red-hi); margin-bottom: auto; transition: background-color var(--dur-3), color var(--dur-3), transform var(--dur-3) var(--ease-out); }
.val:hover .ic { background: var(--red); color: var(--on-red); transform: rotate(-6deg); }
.val .ic svg { width: 24px; height: 24px; }
.val h3 { font: 700 18px/1.2 var(--font-display); font-stretch: 110%; margin-top: var(--space-lg); }
.val p { font-size: 14.5px; color: var(--ink-2); }
.proc { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); }
.proc .stick { position: sticky; top: 130px; align-self: start; }
.proc .stick .lead { margin-top: var(--space-lg); }
.tl { position: relative; padding-left: 44px; }
.tl::before { content: ""; position: absolute; left: 14px; top: 10px; bottom: 10px; width: 2px; background: var(--stroke); border-radius: 2px; }
.tl .fill { position: absolute; left: 14px; top: 10px; width: 2px; height: 0; border-radius: 2px; background: linear-gradient(var(--red-hi), var(--red-lo)); }
.ti { position: relative; padding: clamp(22px, 2.6vw, 30px); margin-bottom: 14px; border-radius: var(--r-lg); }
.ti::before { content: ""; position: absolute; left: -37px; top: 34px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 2px solid var(--stroke-3); transition: background-color var(--dur-3), border-color var(--dur-3), box-shadow var(--dur-3); }
.ti.lit::before { background: var(--red); border-color: var(--red); box-shadow: 0 0 0 6px var(--red-soft); }
.ti .stp { font: 500 12px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--red-hi); }
.ti h3 { font: 700 clamp(19px, 1.7vw, 24px)/1.2 var(--font-display); font-stretch: 110%; margin: 10px 0 8px; }
.ti p { color: var(--ink-2); }
@media (max-width: 1000px) { .proc { grid-template-columns: minmax(0, 1fr); } .proc .stick { position: static; } }
.mosaic { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(170px, 16vw, 240px); grid-auto-flow: dense; gap: 12px; }
.mosaic a { position: relative; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--stroke); }
.mosaic a.big { grid-column: span 2; grid-row: span 2; } .mosaic a.tall { grid-row: span 2; } .mosaic a.wide { grid-column: span 2; }
.mosaic .ph { position: absolute; inset: 0; }
.mosaic a::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, oklch(0% 0 0 / .7)); pointer-events: none; }
.mosaic a:hover .ph img { transform: scale(1.06); }
.mosaic .cap { position: absolute; z-index: 2; left: 16px; right: 16px; bottom: 14px; color: oklch(98% 0 0); display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; }
.mosaic .cap b { display: block; font: 700 16px/1.2 var(--font-display); font-stretch: 108%; }
.mosaic .cap small { font-size: 12.5px; color: oklch(100% 0 0 / .72); }
.mosaic .cap svg { width: 18px; height: 18px; flex: none; transition: transform var(--dur-3) var(--ease-out); }
.mosaic a:hover .cap svg { transform: rotate(45deg); }
@media (max-width: 760px) {
  .mosaic { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 74%; grid-auto-rows: 300px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px var(--gut) 20px; margin-inline: calc(var(--gut) * -1); scrollbar-width: none; }
  .mosaic::-webkit-scrollbar { display: none; } .mosaic a { scroll-snap-align: start; grid-column: auto !important; grid-row: auto !important; }
}
