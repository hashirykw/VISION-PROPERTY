VP.boot(function(){
  const {$, $$, D, img, esc} = VP;
  $('#l1').innerHTML = img(D.STOCK.meeting, 'Consultation');
  $('#l2').innerHTML = img(D.STOCK.keys, 'Handing over keys');
  $('#l3').innerHTML = img(D.STOCK.handshake, 'Closing the deal');
  $('#bSeal').innerHTML = `<img src="${$('.brand .seal img').src}" alt="">`;
  /* 3D parallax stack */
  const st = $('#stack3');
  if (VP.FINE && !VP.RM) {
    st.addEventListener('pointermove', e => { const r = st.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      $$('[data-depth]', st).forEach(l => { const d = +l.dataset.depth; l.style.transform = `translate3d(${x * d * .5}px,${y * d * .5}px,0) rotateY(${x * 10}deg) rotateX(${-y * 10}deg)`; }); });
    st.addEventListener('pointerleave', () => $$('[data-depth]', st).forEach(l => l.style.transform = ''));
  }
  const M = [['saima-waterfront',0,'big'],['saima-marina-residence',0,'tall'],['roomi-icon',1,''],['saars-3',0,''],['paari-palace',1,'wide'],['saima-greens',1,''],['saima-jinnah-mall-residence',1,''],['saima-dreams',1,'wide'],['e-square',1,''],['saima-marina-residence',4,'']];
  $('#mosaic').innerHTML = M.map(([s,k,c],i) => { const p = D.P.find(x => x.s === s), x = p.pics[Math.min(k, p.pics.length - 1)];
    return `<a class="${c} rv d${i%4}" href="project.html?p=${p.s}" data-tilt="5" data-spot>${img(x, p.n)}<span class="cap"><span><b>${esc(p.n)}</b><small>${esc(p.area)}</small></span><span class="go">${VP.I.ne}</span></span><span class="glare"></span></a>`; }).join('');
  /* timeline fill */
  const tl = $('#tl'), fill = $('#tlFill'), items = $$('.ti', tl);
  const upd = () => { const r = tl.getBoundingClientRect(), p = Math.min(1, Math.max(0, (innerHeight * .6 - r.top) / r.height));
    fill.style.height = (p * (r.height - 16)) + 'px';
    items.forEach(it => it.classList.toggle('lit', it.getBoundingClientRect().top < innerHeight * .6)); };
  addEventListener('scroll', upd, {passive:true}); upd();
  /* logos */
  const L = D.AFF.map(a => `<div class="lg">${VP.rawImg(a, a.n)}<span>${esc(a.n)}</span></div>`).join('');
  $('#logos').innerHTML = L + L.replace(/alt="[^"]*"/g, 'alt=""');
  $$('#logos img').forEach(im => im.addEventListener('vpfail', () => im.parentNode.classList.add('nf')));
});
