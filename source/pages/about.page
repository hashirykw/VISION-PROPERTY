@page: about
@title: About — Vision Properties, Karachi
@desc: Vision Properties is a full-service real estate marketing and investment consulting company in North Nazimabad, Karachi. Our vision, mission, approach and process.
===CSS===
.ab{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,5vw,70px);align-items:center}
.stack3{position:relative;height:clamp(380px,40vw,520px);perspective:1400px}
.stack3 .layer{position:absolute;border-radius:26px;overflow:hidden;padding:8px;transition:transform .9s var(--e-out)}
.stack3 .layer .ph{width:100%;height:100%;border-radius:20px}
.stack3 .l1{left:0;top:6%;width:62%;height:70%}
.stack3 .l2{right:0;top:0;width:46%;height:46%}
.stack3 .l3{right:6%;bottom:0;width:52%;height:46%}
.stack3 .badge{position:absolute;left:8%;bottom:4%;z-index:5;padding:16px 18px;border-radius:20px;display:flex;align-items:center;gap:12px}
.stack3 .badge .seal{width:46px;height:46px}
.stack3 .badge b{font:700 15px/1.2 var(--f-head);display:block}
.stack3 .badge small{font-size:12px;color:var(--ink-3)}
.vmg{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;perspective:1400px}
.vm{padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:16px;min-height:300px}
.vm .q{font:400 clamp(21px,1.8vw,26px)/1.35 var(--f-serif);font-style:italic;color:var(--ink)}
.vm .q::before{content:"\201C";display:block;font-size:64px;line-height:.6;color:var(--red-2);margin-bottom:6px}
.vm .who{margin-top:auto;display:flex;align-items:center;gap:12px;padding-top:16px;border-top:1px dashed var(--line-2)}
.vm .who i{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--red);color:#fff;font:800 15px/1 var(--f-head);font-style:normal}
.vm .who b{font:700 15px/1.2 var(--f-head);display:block}
.vm .who small{font-size:12px;color:var(--ink-3)}
.vals{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;perspective:1400px}
.val{padding:26px;min-height:250px;display:flex;flex-direction:column;gap:12px}
.val .ic{width:56px;height:56px;border-radius:18px;display:grid;place-items:center;background:var(--red-a);color:var(--red-2);margin-bottom:auto;transition:background .4s,color .4s,transform .6s var(--e-spring)}
.val:hover .ic{background:var(--red);color:#fff;transform:rotate(-8deg) scale(1.06)}
.val .ic svg{width:26px;height:26px}
.val h3{font:700 18px/1.2 var(--f-head);margin-top:24px}
.val p{font-size:14.5px;color:var(--ink-2)}
.val .n{position:absolute;right:22px;top:18px;font:500 11px/1 var(--f-mono);color:var(--ink-4)}
.proc{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(30px,5vw,80px)}
.proc .stick{position:sticky;top:120px;align-self:start}
.tl{position:relative;padding-left:40px}
.tl::before{content:"";position:absolute;left:13px;top:8px;bottom:8px;width:2px;background:repeating-linear-gradient(180deg,var(--line-3) 0 6px,transparent 6px 12px)}
.tl .fill{position:absolute;left:13px;top:8px;width:2px;height:0;background:linear-gradient(var(--red-2),var(--red-3));border-radius:2px}
.ti{position:relative;padding:26px;margin-bottom:16px}
.ti::before{content:"";position:absolute;left:-34px;top:32px;width:16px;height:16px;border-radius:50%;background:var(--bg);border:2px solid var(--line-3);transition:all .4s}
.ti.lit::before{background:var(--red);border-color:var(--red);box-shadow:0 0 0 6px var(--red-a),0 0 18px var(--red-glow)}
.ti .mono{color:var(--red-2)}
.ti h3{font:700 clamp(19px,1.7vw,23px)/1.2 var(--f-head);margin:8px 0}
.ti p{color:var(--ink-2);font-size:15px}
.ti ul{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.mosaic{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:clamp(160px,17vw,240px);grid-auto-flow:dense;gap:14px;perspective:1400px}
.mosaic a{position:relative;border-radius:22px;overflow:hidden;border:1px solid var(--line-2);box-shadow:var(--shadow-s)}
.mosaic a.big{grid-column:span 2;grid-row:span 2}.mosaic a.tall{grid-row:span 2}.mosaic a.wide{grid-column:span 2}
.mosaic .ph{position:absolute;inset:0}
.mosaic a:hover .ph img{transform:scale(1.07)}
.mosaic a::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(8,8,10,.8));pointer-events:none}
.mosaic .cap{position:absolute;left:14px;right:14px;bottom:12px;z-index:3;color:#fff;display:flex;justify-content:space-between;align-items:flex-end;gap:8px;transform:translateZ(30px)}
.mosaic .cap b{font:700 15px/1.2 var(--f-head);display:block}
.mosaic .cap small{font-size:12px;color:rgba(255,255,255,.72)}
.mosaic .cap .go{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.14);backdrop-filter:blur(8px);flex:none;transition:background .3s,transform .5s var(--e-out)}
.mosaic a:hover .cap .go{background:var(--red);transform:rotate(-45deg)}
.mosaic .cap .go svg{width:15px;height:15px}
@media (max-width:860px){.mosaic{grid-template-columns:1fr 1fr;grid-auto-rows:170px}.mosaic a.wide{grid-column:span 2}}
.logos{display:flex;gap:14px;width:max-content;animation:mq 34s linear infinite}
.lwrap{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);padding:10px 0}
.lwrap:hover .logos{animation-play-state:paused}
.lg{width:180px;height:104px;border-radius:22px;display:grid;place-items:center;padding:16px;flex:none;background:rgba(255,255,255,.92);border:1px solid var(--line);transition:transform .5s var(--e-out)}
.lg:hover{transform:translateY(-4px)}
.lg img{max-width:100%;max-height:100%;object-fit:contain;filter:grayscale(1);opacity:.75;transition:all .4s}
.lg:hover img{filter:none;opacity:1}
.lg span{display:none;font:800 14px/1 var(--f-head);color:#171717;letter-spacing:.04em;text-transform:uppercase}
.lg.nf img{display:none}.lg.nf span{display:block}
@media (max-width:1000px){.ab,.proc{grid-template-columns:1fr}.proc .stick{position:static}.vmg{grid-template-columns:1fr}.vals{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.vals{grid-template-columns:1fr}.stack3{height:360px}}
