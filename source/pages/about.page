===JS===
VP.boot(function(){
  const {$, $$, esc, D, img, I} = VP, find = s => D.P.find(x => x.s === s);
  VP.stage($('#aStage'), { dur: 3000, delay: 300, fit: .84, max: 230 });
  const tl = $('#tl'), fill = $('#tlFill'), items = $$('.ti', tl);
  const upd = () => { const r = tl.getBoundingClientRect(), p = Math.min(1, Math.max(0, (innerHeight * .6 - r.top) / r.height)); fill.style.height = (p * (r.height - 20)) + 'px'; items.forEach(it => it.classList.toggle('lit', it.getBoundingClientRect().top < innerHeight * .6)); };
  addEventListener('scroll', upd, { passive: true }); upd();
  const M = [['saima-waterfront', 0, 'big'], ['saima-marina-residence', 1, 'tall'], ['roomi-icon', 1, ''], ['saars-3', 0, ''], ['paari-palace', 1, 'wide'], ['saima-greens', 1, ''], ['saima-jinnah-mall-residence', 1, ''], ['saima-dreams', 1, 'wide'], ['e-square', 1, ''], ['saima-marina-residence', 6, '']];
  $('#mosaic').innerHTML = M.map(([s, k, c], i) => { const p = find(s), x = p.pics[Math.min(k, p.pics.length - 1)];
    return `<a class="${c} rv d${i % 4}" href="project.html?p=${p.s}" data-spot>${img(x, p.n)}<span class="cap"><span><b>${esc(p.n)}</b><small>${esc(p.area)}</small></span>${I.ne}</span></a>`; }).join('');
  $('#devs').innerHTML = D.AFF.map(a => `<div class="lg">${VP.rawImg(a, a.n)}<span>${esc(a.n)}</span></div>`).join('');
  $$('#devs img').forEach(im => im.addEventListener('vpfail', () => im.parentNode.classList.add('nf')));
});
