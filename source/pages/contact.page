===JS===
VP.boot(function(){
  const {$, $$, D, I} = VP;
  VP.stage($('#cStage'), { dur: 3000, delay: 300, fit: .84, max: 230 });
  $('#i1').innerHTML = I.pin; $('#i1b').innerHTML = I.map; $('#i2').innerHTML = I.phone; $('#i3').innerHTML = I.wa; $('#i4').innerHTML = I.mail; $('#i5').innerHTML = I.share;
  $$('[data-copy]').forEach(b => { b.innerHTML = I.copy; b.addEventListener('click', () => VP.copy(b.dataset.copy, 'Copied ' + b.dataset.copy)); });
  $('#soc').innerHTML = [['fb', D.C.fb, 'Facebook'], ['ig', D.C.ig, 'Instagram'], ['yt', D.C.yt, 'YouTube']].map(s => `<a class="ib" href="${s[1]}" target="_blank" rel="noopener" aria-label="${s[2]}">${I[s[0]]}</a>`).join('');
  $$('.seg').forEach(g => g.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; $$('button', g).forEach(x => x.setAttribute('aria-pressed', x === b)); }));
  VP.leadForm($('#enquire'), f => ['Looking to: ' + $('[data-name=want] [aria-pressed=true]', f).textContent, 'Area: ' + $('#fa').value, $('#fb').value.trim() ? 'Budget: ' + $('#fb').value.trim() : '', $('#fm').value.trim() ? 'Message: ' + $('#fm').value.trim() : '']);
  VP.faq($('#faqList'));
});
