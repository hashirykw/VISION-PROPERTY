@page: contact
@title: Contact — Vision Properties, Karachi
@desc: Visit Vision Properties at B-115, Block H, Main Food Street, North Nazimabad, Karachi. Call 0330 2152999 or 0322 2710896, WhatsApp, or send an enquiry.
===CSS===
.cg{display:grid;grid-template-columns:.9fr 1.1fr;gap:20px;align-items:start;perspective:1400px}
.ccards{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.cc{padding:22px;display:flex;flex-direction:column;gap:10px;min-height:170px}
.cc.wide{grid-column:span 2}
.cc .ic{width:48px;height:48px;border-radius:15px;display:grid;place-items:center;background:var(--red-a);color:var(--red-2);margin-bottom:auto;transition:background .4s,color .4s,transform .6s var(--e-spring)}
.cc:hover .ic{background:var(--red);color:#fff;transform:rotate(-8deg)}
.cc .ic svg{width:22px;height:22px}
.cc small{display:block;font:500 10.5px/1 var(--f-mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-top:14px}
.cc b{font:700 17px/1.3 var(--f-head)}
.cc a.l{transition:color .3s}.cc a.l:hover{color:var(--red-2)}
.cc .lines{display:grid;gap:4px}
.cc.wa{background:linear-gradient(150deg,rgba(37,211,102,.18),var(--panel) 60%)}
.cc.wa .ic{background:rgba(37,211,102,.16);color:#25d366}
.cc.wa:hover .ic{background:#25d366;color:#04210f}
.form{padding:clamp(22px,3vw,38px);display:grid;gap:18px}
.form .two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form .ok{display:none;align-items:center;gap:10px;padding:14px 16px;border-radius:14px;background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.3);font-size:14px}
.form .ok.show{display:flex}
.mapbig{margin-top:20px;border-radius:var(--r-5);overflow:hidden;padding:10px;position:relative}
.mapbig iframe{display:block;width:100%;height:clamp(320px,38vw,460px);border:0;border-radius:32px}
:root[data-theme="dark"] .mapbig iframe{filter:invert(.9) hue-rotate(180deg) grayscale(.4) contrast(.95)}
.mapbig .pinc{position:absolute;left:30px;bottom:30px;z-index:3;padding:16px 18px;border-radius:20px;display:flex;align-items:center;gap:12px;max-width:min(420px,calc(100% - 60px))}
.mapbig .pinc .seal{width:44px;height:44px}
.mapbig .pinc b{font:700 15px/1.2 var(--f-head);display:block}
.mapbig .pinc small{font-size:12.5px;color:var(--ink-3)}
.strip6{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:clamp(150px,14vw,200px);grid-auto-flow:dense;gap:14px;perspective:1400px}
.strip6 a{position:relative;border-radius:22px;overflow:hidden;border:1px solid var(--line-2);box-shadow:var(--shadow-s)}
.strip6 a.big{grid-column:span 2;grid-row:span 2}.strip6 a.tall{grid-row:span 2}.strip6 a.wide{grid-column:span 2}
.strip6 .ph{position:absolute;inset:0}
.strip6 a:hover .ph img{transform:scale(1.07)}
.strip6 a::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(8,8,10,.8));pointer-events:none}
.strip6 .cap{position:absolute;left:14px;right:14px;bottom:12px;z-index:3;color:#fff;display:flex;justify-content:space-between;align-items:flex-end;gap:8px;transform:translateZ(30px)}
.strip6 .cap b{font:700 15px/1.2 var(--f-head);display:block}
.strip6 .cap small{font-size:12px;color:rgba(255,255,255,.72)}
.strip6 .cap .go{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.14);backdrop-filter:blur(8px);flex:none;transition:background .3s,transform .5s var(--e-out)}
.strip6 a:hover .cap .go{background:var(--red);transform:rotate(-45deg)}
.strip6 .cap .go svg{width:15px;height:15px}
@media (max-width:860px){.strip6{grid-template-columns:1fr 1fr;grid-auto-rows:160px}.strip6 a.wide{grid-column:span 2}}
.faqg{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(24px,5vw,70px);align-items:start}
.faqg .stick{position:sticky;top:120px}
@media (max-width:980px){.cg,.faqg{grid-template-columns:1fr}.faqg .stick{position:static}}
@media (max-width:560px){.ccards{grid-template-columns:1fr}.cc.wide{grid-column:auto}.form .two{grid-template-columns:1fr}.mapbig .pinc{left:20px;bottom:20px}}
