===JS===
VP.boot(function(){
  const {$, $$, D, I, wa} = VP;
  $('#icPin').innerHTML = I.pin; $('#icPh').innerHTML = I.phone; $('#icWa').innerHTML = I.wa; $('#icMail').innerHTML = I.mail;
  $('#soc').innerHTML = [['fb', D.C.fb, 'Facebook'], ['ig', D.C.ig, 'Instagram'], ['yt', D.C.yt, 'YouTube']].map(s => `<a class="ibtn" href="${s[1]}" target="_blank" rel="noopener" aria-label="${s[2]}">${I[s[0]]}</a>`).join('');
  $('#mSeal').innerHTML = `<img src="${$('.brand .seal img').src}" alt="">`;
  $$('.seg').forEach(g => g.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; $$('button', g).forEach(x => x.classList.toggle('on', x === b)); }));
  $('#lead').addEventListener('submit', e => {
    e.preventDefault(); const n = $('#fn'), p = $('#fp'); [n, p].forEach(x => x.classList.remove('err'));
    if (!n.value.trim()) { n.classList.add('err'); n.focus(); VP.toast('Please add your name'); return; }
    if (!/^[+\d][\d\s-]{6,}$/.test(p.value.trim())) { p.classList.add('err'); p.focus(); VP.toast('Please add a valid phone number'); return; }
    const v = id => $(id).value.trim();
    const msg = ['Hi Vision Properties,', 'Name: ' + v('#fn'), 'Phone: ' + v('#fp'), 'Looking to: ' + $('#want .on').textContent, 'Area: ' + $('#area .on').textContent, v('#fb') ? 'Budget: ' + v('#fb') : '', v('#fm') ? 'Message: ' + v('#fm') : ''].filter(Boolean).join('\n');
    VP.sfx.chime(); open(wa(msg), '_blank', 'noopener'); $('#ok').classList.add('show');
  });
  VP.faq($('#faqList'));
  $('#strip6').innerHTML = [['saima-marina-residence','wide'],['roomi-icon','tall'],['saima-waterfront',''],['saars-3',''],['paari-palace','wide'],['saima-greens','']].map(([s,c],i) => { const p = D.P.find(x => x.s === s);
    return `<a class="${c} rv d${i%4}" href="project.html?p=${p.s}" data-tilt="5" data-spot>${VP.img(p.pics[0], p.n)}<span class="cap"><span><b>${VP.esc(p.n)}</b><small>${VP.esc(p.area)}</small></span><span class="go">${I.ne}</span></span><span class="glare"></span></a>`; }).join('');
});
