@page: contact
@title: Contact · Vision Properties, Karachi
@desc: Visit Vision Properties at B-115, Block H, Main Food Street, North Nazimabad, Karachi. Call 0330 2152999 or 0322 2710896, email info@visionproperties.pk, or send an enquiry.
@head: <link rel="preload" as="image" href="images/ui/tower-water.webp">
===CSS===
.phero .stage { --word-top: 14%; --th: 88%; --ta: .638; --tx: 73%; }
@media (max-width: 860px) { .phero .stage { --tx: 64%; --th: 80%; --word-top: 27%; } }
.cg { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(20px, 3vw, 36px); align-items: start; }
.lines { padding: clamp(18px, 2.4vw, 28px); border-radius: var(--r-xl); }
.ln { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 16px 4px; border-bottom: 1px solid var(--stroke); }
.ln:last-child { border-bottom: 0; }
.ln .ic { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: var(--glass-2); border: 1px solid var(--stroke); color: var(--red-hi); }
.ln .ic svg { width: 19px; height: 19px; }
.ln small { display: block; font-size: 12.5px; color: var(--ink-3); }
.ln a.v, .ln span.v { display: block; font: 600 16px/1.35 var(--font-body); transition: color var(--dur-2); overflow-wrap: anywhere; }
.ln a.v:hover { color: var(--red-hi); }
.ln .side { display: flex; gap: 6px; }
.ln .side .ib { width: 40px; height: 40px; }
.ln .side .ib svg { width: 16px; height: 16px; }
@media (max-width: 420px) { .ln { grid-template-columns: 40px minmax(0, 1fr); } .ln .side { grid-column: 2; } .ln .ic { width: 40px; height: 40px; } }
.ln .nums { display: grid; gap: 4px; }
.cform { padding: clamp(24px, 3.4vw, 44px); border-radius: var(--r-xl); display: grid; gap: var(--space-lg); scroll-margin-top: 120px; }
@media (max-width: 960px) { .cg { grid-template-columns: minmax(0, 1fr); } }
.faqg { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
.faqg .stick { position: sticky; top: 130px; }
.faqg .stick .lead { margin-top: var(--space-lg); }
.faqg .qbox { padding: 6px clamp(18px, 2.4vw, 30px); border-radius: var(--r-xl); }
@media (max-width: 900px) { .faqg { grid-template-columns: minmax(0, 1fr); } .faqg .stick { position: static; } }
