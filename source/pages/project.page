@page: project
@title: Project · Vision Properties, Karachi
@desc: Project photos, details, amenities and location from Vision Properties, Karachi. Ask us for current prices, availability and payment plans.
===CSS===
.pv { padding-top: calc(14px + var(--nav-h) + clamp(28px, 4vw, 56px)); }
.pv-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, .9fr); gap: clamp(20px, 3vw, 44px); align-items: start; }
.frame { padding: 8px; border-radius: var(--r-xl); }
.frame .main { position: relative; border-radius: calc(var(--r-xl) - 8px); overflow: hidden; aspect-ratio: 16 / 11; cursor: zoom-in; }
.frame .main .ph { position: absolute; inset: 0; }
.frame .main .ph img { transition: opacity var(--dur-3), transform 1.6s var(--ease-out); }
.frame .main:hover .ph img { transform: scale(1.03); }
.frame .zoom { position: absolute; right: 14px; bottom: 14px; z-index: 2; color: oklch(98% 0 0); background: oklch(15% .01 25 / .4); border-color: oklch(100% 0 0 / .2); }
.frame .badge { position: absolute; left: 14px; top: 14px; z-index: 2; padding: 7px 11px; border-radius: 10px; font: 500 11px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: oklch(99% 0 0); background: var(--red); }
.thumbs { display: flex; gap: 8px; overflow-x: auto; padding: 10px 2px 2px; scrollbar-width: none; }
.thumbs::-webkit-scrollbar { display: none; }
.thumbs button { flex: none; width: 92px; height: 66px; border-radius: 12px; overflow: hidden; opacity: .5; border: 2px solid transparent; transition: opacity var(--dur-2), border-color var(--dur-2); }
.thumbs button:hover { opacity: .85; }
.thumbs button[aria-current="true"] { opacity: 1; border-color: var(--red-hi); }
.thumbs .ph { width: 100%; height: 100%; }
.info-p { padding: clamp(22px, 3vw, 36px); border-radius: var(--r-xl); position: sticky; top: calc(14px + var(--nav-h) + 20px); }
.info-p .h1 { font-size: clamp(34px, 3.8vw, 58px); }
.info-p .loc { display: flex; gap: 8px; align-items: flex-start; margin-top: var(--space-md); color: var(--ink-2); }
.info-p .loc svg { width: 18px; height: 18px; color: var(--red-hi); flex: none; margin-top: 3px; }
.facts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin-top: var(--space-xl); border-top: 1px solid var(--stroke); }
.facts div { padding: 16px 0; border-bottom: 1px solid var(--stroke); }
.facts div:nth-child(odd) { padding-right: 14px; } .facts div:nth-child(even) { padding-left: 14px; border-left: 1px solid var(--stroke); }
.facts dt { font-size: 12.5px; color: var(--ink-3); }
.facts dd { margin-top: 4px; font: 600 15.5px/1.3 var(--font-body); }
.info-p .acts { margin-top: var(--space-xl); display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; gap: 8px; align-items: center; }
.info-p .acts .btn { justify-self: stretch; justify-content: space-between; }
.info-p .acts .ib { width: 54px; height: 54px; }
@media (max-width: 420px) { .info-p .acts { grid-template-columns: repeat(3, minmax(0, 1fr)); } .info-p .acts .btn { grid-column: 1 / -1; } .info-p .acts .ib { width: 100%; border-radius: 16px; } }
@media (max-width: 1020px) { .pv-grid { grid-template-columns: minmax(0, 1fr); } .info-p { position: static; } }
.ov { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
.ov .big { font-size: clamp(18px, 1.5vw, 22px); line-height: 1.6; color: var(--ink-2); margin-top: var(--space-lg); }
.amen { padding: clamp(20px, 2.6vw, 32px); border-radius: var(--r-lg); }
.amen ul { list-style: none; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2px 18px; margin-top: var(--space-md); }
.amen li { display: flex; gap: 10px; align-items: flex-start; padding: 11px 0; border-bottom: 1px solid var(--stroke); font-size: 14.5px; }
.amen li svg { width: 16px; height: 16px; color: var(--red-hi); flex: none; margin-top: 3px; }
@media (max-width: 900px) { .ov { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 480px) { .amen ul { grid-template-columns: minmax(0, 1fr); } }
.gal { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(150px, 15vw, 220px); grid-auto-flow: dense; gap: 12px; }
.gal button { position: relative; border-radius: 18px; overflow: hidden; border: 1px solid var(--stroke); cursor: zoom-in; }
.gal button:nth-child(7n+1) { grid-column: span 2; grid-row: span 2; }
.gal button:nth-child(7n+5) { grid-row: span 2; }
.gal .ph { position: absolute; inset: 0; }
.gal button:hover .ph img { transform: scale(1.06); }
@media (max-width: 760px) {
  .gal { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 78%; grid-auto-rows: 220px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px var(--gut) 20px; margin-inline: calc(var(--gut) * -1); scrollbar-width: none; }
  .gal::-webkit-scrollbar { display: none; } .gal button { scroll-snap-align: start; grid-column: auto !important; grid-row: auto !important; }
}
.plans { --cols: 3; --mcol: 62%; }
.plans button { position: relative; aspect-ratio: 3 / 4; border-radius: 18px; overflow: hidden; background: oklch(99% 0 0); border: 1px solid var(--stroke); cursor: zoom-in; transition: transform var(--dur-3) var(--ease-out); }
.plans button:hover { transform: translateY(-4px); }
.plans .ph { position: absolute; inset: 10px; background: oklch(99% 0 0); }
.plans .ph img { object-fit: contain; }
.plans .lbl { position: absolute; left: 12px; bottom: 12px; padding: 6px 10px; border-radius: 9px; font: 500 11px/1 var(--font-mono); color: oklch(99% 0 0); background: var(--red); }
.penq { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); padding: clamp(26px, 4vw, 52px); border-radius: var(--r-xl); align-items: start; }
.penq form { display: grid; gap: var(--space-md); }
@media (max-width: 900px) { .penq { grid-template-columns: minmax(0, 1fr); } }
.pn { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; margin-top: var(--space-xl); }
.pn a { padding: 20px 22px; border-radius: var(--r-lg); display: grid; gap: 4px; }
.pn a:last-child { text-align: right; }
.pn small { font-size: 12.5px; color: var(--ink-3); }
.pn b { font: 700 18px/1.2 var(--font-display); font-stretch: 108%; }
@media (max-width: 560px) { .pn b { font-size: 15px; } }
.rel-h { display: flex; justify-content: space-between; align-items: end; gap: var(--space-lg); margin-bottom: var(--space-lg); }
#rel { --cols: 3; --mcol: 76%; }
.nf { padding: 60px 24px; text-align: center; border-radius: var(--r-xl); }
===HTML===
<section class="pv" data-shape="house" data-shape-x=".5" data-shape-y=".05" data-shape-s=".75" data-shape-a=".22" data-shape-ma=".1">
  <div class="wrap" id="pv"></div>
</section>
<div id="body"></div>
===JS===
VP.boot(function(){
  const {$, $$, esc, D, I, img, wa} = VP, P = D.P;
  const slug = new URLSearchParams(location.search).get('p'), p = P.find(x => x.s === slug), i0 = P.indexOf(p);
  if (!p) {
    $('#pv').innerHTML = `<div class="nf glass"><h1 class="h2">Project not <span class="accent">found.</span></h1><p class="lead" style="margin:16px auto 0">That link may be out of date. Browse every project we market instead.</p><div class="acts" style="justify-content:center"><a class="btn btn-primary" href="projects.html" data-i="arrow">See all projects</a></div></div>`;
    return;
  }
  document.title = `${p.n} · Vision Properties, Karachi`;
  const md = $('meta[name="description"]'); if (md) md.content = (p.d || `${p.n}, ${p.loc}. Marketed by Vision Properties, Karachi.`).slice(0, 158);
  const msg = `Hi Vision Properties, I'm interested in ${p.n}. Please share availability, prices and the payment plan.`;
  const facts = [['Type', p.type], ['Units', p.units], ['Building', p.floors], ['Developer', p.dev], ['Area', p.area]].filter(f => f[1]).slice(0, 4);
  $('#pv').innerHTML = `
    <nav class="crumbs rv" aria-label="Breadcrumb"><a href="index.html">Home</a><i></i><a href="projects.html">Projects</a><i></i><span>${esc(p.n)}</span></nav>
    <div class="pv-grid">
      <div class="rv">
        <div class="frame glass" data-spot>
          <div class="main" id="main" role="button" tabindex="0" aria-label="Open photo viewer">${img(p.pics[0], p.n, '', true)}${p.hot ? `<span class="badge">${esc(p.hot)}</span>` : ''}<button class="ib zoom" id="zoom" aria-label="View all ${p.pics.length} photos full screen">${I.expand}</button></div>
          ${p.pics.length > 1 ? `<div class="thumbs" id="thumbs">${p.pics.map((x, j) => `<button aria-label="Show photo ${j + 1}" aria-current="${!j}" data-j="${j}">${img(x, '')}</button>`).join('')}</div>` : ''}
        </div>
      </div>
      <aside class="info-p glass rv d1" data-spot>
        <span class="kicker">${esc(p.area)}</span>
        <h1 class="h1 split">${esc(p.n)}</h1>
        <p class="loc">${I.pin}<span>${esc(p.loc)}</span></p>
        <dl class="facts">${facts.map(f => `<div><dt>${f[0]}</dt><dd>${esc(f[1])}</dd></div>`).join('')}</dl>
        <div class="acts"><a class="btn btn-primary" href="#penq" data-i="arrow">Get prices</a><a class="ib" href="tel:+923302152999" aria-label="Call Vision Properties">${I.phone}</a><a class="ib" href="${wa(msg)}" target="_blank" rel="noopener" aria-label="Message on WhatsApp">${I.wa}</a><button class="ib" id="share" aria-label="Share this project">${I.share}</button></div>
      </aside>
    </div>`;
  const desc = p.d || `${p.n} is one of the projects listed with Vision Properties. Unit sizes, prices and payment plans change often, so we share them directly rather than show figures that could be out of date. Ask us and we'll send the latest details and payment schedule.`;
  const q = encodeURIComponent(/karachi/i.test(p.loc) ? p.loc : p.loc + ', Karachi');
  const same = P.filter(x => x !== p && x.f.some(f => p.f.includes(f) && f !== 'apt'));
  const rel = same.concat(P.filter(x => x !== p && !same.includes(x) && x.d && x.pics.length > 1)).slice(0, 6);
  const prev = P[(i0 - 1 + P.length) % P.length], next = P[(i0 + 1) % P.length];
  $('#body').innerHTML = `
    <section class="sec" data-shape="plan" data-shape-x="-.55" data-shape-y=".1" data-shape-s=".6" data-shape-a=".25" data-shape-ma=".1"><div class="wrap ov">
      <div><h2 class="h2 split" style="font-size:clamp(30px,3.6vw,52px)">About <span class="accent">${esc(p.n)}.</span></h2><p class="big rv d1">${esc(desc)}</p></div>
      <div class="amen glass rv d2" data-spot><h3 class="h3">${p.a.length ? 'Amenities & features' : 'Amenities'}</h3>${p.a.length ? `<ul>${p.a.map(a => `<li>${I.check}<span>${esc(a)}</span></li>`).join('')}</ul>` : `<p class="muted" style="margin-top:12px">Ask us for this project's full amenity list.</p>`}</div>
    </div></section>
    ${p.pics.length > 1 ? `<section class="sec tight" data-shape="cloud" data-shape-s="1.2" data-shape-a=".25" data-shape-ma=".1"><div class="wrap"><div class="rel-h"><h2 class="h2 split" style="font-size:clamp(30px,3.6vw,52px)">${p.pics.length} photos.</h2><button class="btn btn-glass btn-sm" id="galAll" data-i="expand">Full-screen gallery</button></div><div class="gal" id="gal">${p.pics.map((x, j) => `<button data-j="${j}" aria-label="Open photo ${j + 1} of ${p.pics.length}">${img(x, p.n + ', photo ' + (j + 1))}</button>`).join('')}</div></div></section>` : ''}
    ${p.planPics.length ? `<section class="sec tight"><div class="wrap"><div class="rel-h"><div><h2 class="h2" style="font-size:clamp(30px,3.6vw,52px)">Floor plans.</h2><p class="muted" style="margin-top:10px">Type C one-bed layouts across the tower's floor bands. Ask us for the 2, 3 and 4-bed plans.</p></div></div><div class="plans mrail" id="plans">${p.planPics.map((x, j) => `<button data-j="${j}" aria-label="Open floor plan ${j + 1}">${img(x, 'Floor plan ' + (j + 1))}<span class="lbl">Plan ${String(j + 1).padStart(2, '0')}</span></button>`).join('')}</div></div></section>` : ''}
    <section class="sec tight" data-shape="pin" data-shape-x=".55" data-shape-y=".15" data-shape-s=".55" data-shape-a=".25" data-shape-ma=".1"><div class="wrap">
      <div class="mapw glass rv"><iframe title="Map showing ${esc(p.n)}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=${q}&output=embed"></iframe>
      <div class="pinc glass solid"><b>${esc(p.n)}</b><p>${esc(p.loc)}</p><a class="btn btn-glass btn-sm" href="https://www.google.com/maps/search/?api=1&query=${q}" target="_blank" rel="noopener" data-i="map">Open in Google Maps</a></div></div>
    </div></section>
    <section class="sec tight" id="penq"><div class="wrap">
      <div class="penq glass rv" data-spot>
        <div><h2 class="h2" style="font-size:clamp(28px,3.2vw,46px)">Get prices and the payment plan for <span class="accent">${esc(p.n)}.</span></h2><p class="lead" style="margin-top:16px">We'll send current availability, unit sizes and the payment schedule. You can also call <a class="tlink" href="tel:+923302152999">0330 2152999</a>.</p></div>
        <form id="pform" novalidate>
          <div class="two"><div class="field"><label for="en">Your name</label><input class="inp" id="en" name="name" autocomplete="name"><span class="err-msg" aria-live="polite"></span></div><div class="field"><label for="ep">Phone</label><input class="inp" id="ep" name="phone" inputmode="tel" autocomplete="tel"><span class="err-msg" aria-live="polite"></span></div></div>
          <div class="field"><label for="em">Anything else? (optional)</label><textarea class="inp" id="em" name="msg" placeholder="Preferred unit type, floor, or a good time to call"></textarea></div>
          <button class="btn btn-red btn-block" type="submit" data-i="send">Send enquiry</button>
          <p class="muted small">This opens WhatsApp with your details filled in, ready to send.</p>
          <p class="form-ok" hidden>WhatsApp is open with your enquiry. Press send and we'll reply shortly.</p>
        </form>
      </div>
      <nav class="pn" aria-label="More projects"><a class="glass" href="project.html?p=${prev.s}" data-spot><small>Previous project</small><b>${esc(prev.n)}</b></a><a class="glass" href="project.html?p=${next.s}" data-spot><small>Next project</small><b>${esc(next.n)}</b></a></nav>
    </div></section>
    <section class="sec tight" data-shape="skyline" data-shape-s="1.1" data-shape-a=".25" data-shape-ma=".1"><div class="wrap">
      <div class="rel-h"><h2 class="h2 split" style="font-size:clamp(30px,3.6vw,52px)">More to <span class="accent">consider.</span></h2><a class="btn btn-glass btn-sm" href="projects.html" data-i="arrow">All projects</a></div>
      <div class="mrail" id="rel">${rel.map((x, i) => VP.card(x, i)).join('')}</div>
    </div></section>`;
  /* gallery behaviour */
  const G = p.pics.map((x, j) => ({ src: x.src, fb: x.fb, cap: `${p.n} · photo ${j + 1} of ${p.pics.length}` }));
  let cur = 0;
  const setMain = j => { cur = j; $('#main .ph').outerHTML = img(p.pics[j], p.n); VP.wireImgs($('#main')); $$('#thumbs button').forEach((b, k) => b.setAttribute('aria-current', k === j)); };
  $('#main').addEventListener('click', e => { if (!e.target.closest('#zoom')) VP.lightbox(G, cur); });
  $('#main').addEventListener('keydown', e => { if (e.key === 'Enter') VP.lightbox(G, cur); });
  $('#zoom').addEventListener('click', () => VP.lightbox(G, cur));
  if ($('#thumbs')) $('#thumbs').addEventListener('click', e => { const b = e.target.closest('button'); if (b) setMain(+b.dataset.j); });
  if ($('#gal')) { $('#gal').addEventListener('click', e => { const b = e.target.closest('button'); if (b) VP.lightbox(G, +b.dataset.j); }); $('#galAll').addEventListener('click', () => VP.lightbox(G, 0)); }
  if ($('#plans')) { const PL = p.planPics.map((x, j) => ({ src: x.src, fb: x.fb, cap: `${p.n} · floor plan ${j + 1}` })); $('#plans').addEventListener('click', e => { const b = e.target.closest('button'); if (b) VP.lightbox(PL, +b.dataset.j); }); }
  $('#share').addEventListener('click', async () => { try { if (navigator.share) await navigator.share({ title: p.n + ' · Vision Properties', url: location.href }); else VP.copy(location.href, 'Link copied'); } catch (e) { } });
  VP.leadForm($('#pform'), f => ['Project: ' + p.n, $('#em').value.trim() ? 'Note: ' + $('#em').value.trim() : '']);
});
